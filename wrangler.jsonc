{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pelicanzoo",
  "compatibility_date": "2026-09-16",
  // Keep the *.workers.dev address on, so there is somewhere to check a build
  // before pelicanzoo.ai is pointed at it.
  "workers_dev": true,
  // A static site with no server code. Without this file wrangler tries to work
  // that out for itself on deploy, which it cannot do in a non-interactive
  // build — that is what was failing.
  // Run the site build ourselves so the deploy does not depend on the build
  // command configured in the dashboard being right.
  "build": { "command": "npm run build" },
  "assets": { "directory": "./dist" },

  // custom_domain makes the deploy create the DNS records itself, so the zone
  // never drifts from what is in this file. The workers.dev address above stays
  // on as a fallback to check a build against.
  "routes": [
    { "pattern": "pelicanzoo.ai", "custom_domain": true },
    { "pattern": "www.pelicanzoo.ai", "custom_domain": true }
  ]
}
