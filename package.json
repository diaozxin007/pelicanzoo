{
  "name": "pelicanzoo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4330",
    "build": "astro build",
    "preview": "astro preview --port 4330",
    "data": "python3 scripts/fetch_source.py && python3 scripts/extract_specimens.py",
    "deploy": "wrangler deploy",
    "og": "node scripts/make-og.mjs",
    "og:specimens": "node scripts/make-og-specimens.mjs",
    "mirror": "node scripts/mirror-specimens.mjs",
    "score": "node scripts/score-pen.mjs",
    "intake": "node scripts/intake.mjs",
    "backup": "node scripts/backup-pen.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@cloudflare/puppeteer": "^1.4.0",
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "wrangler": "^4.132.0"
  }
}
