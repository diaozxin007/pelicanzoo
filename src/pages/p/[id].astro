---
// One page per specimen. These exist because a share had nowhere to land: the
// zoo was a single index.html, so every link anyone posted went to the front
// gate and showed the same five-pelican card, whichever bird they meant.
import { loadZoo } from '../../lib/zoo.js';
import { findFed } from '../../lib/feed.js';
import { bandOf } from '../../lib/bands.js';
import { BADGE_W, BADGE_H } from '../../lib/badge.js';
import Head from '../../components/Head.astro';
import ogCards from '../../../data/og-cards.json';
import '../../styles/tokens.css';

// Looked up when the page is asked for rather than enumerated at build time.
// That is the whole point of the database: a pelican fed thirty seconds ago has
// a page, and it is this one.
//
// The permanent collection wins on an id collision. A submission filed under a
// specimen's name would otherwise silently replace a bird that links back to
// Simon; it goes pageless instead.
const { id } = Astro.params;
const s = loadZoo().all.find((x) => x.id === id) || (await findFed(Astro.locals.runtime?.env, id));
if (!s) return new Response(null, { status: 404, statusText: 'no such pelican' });
// Fed pelicans differ in every direction that matters here: no post to link
// back to, a model name nobody can verify, and source that exists only in this
// page rather than as a file the worker can read for itself.
const fed = s.origin === 'feed';

// Most of these are pelicans. A few models drew something else entirely, and
// the page should not stand in front of an opossum calling it a pelican.
const subject = !s.species || s.species === 'pelican' ? 'a pelican' : `a ${s.species}`;
const title = `${s.model} drew ${subject} riding a bicycle — Pelican Zoo`;
const description = fed
  ? `${s.model} riding a bicycle, fed to Pelican Zoo${s.by ? ` by ${s.by}` : ''}` +
    `${s.observed ? ` on ${s.observed}` : ''}. The model is self-reported.`
  : s.verdict
    ? `${s.verdict} — ${s.model}, ${s.observed}, in Pelican Zoo.`
    : `${s.model} (${s.vendor}) was asked for an SVG of a pelican riding a bicycle in ` +
      `${s.observed}. This is what came back.`;

// Fed pelicans have no post behind them, but they do have the drawing exactly
// as it arrived — which is the honest equivalent. It used to point at a file in
// the repository; the row is the record now, so it points at the row.
const sourceUrl = fed ? `/fed/${s.id}.svg` : s.post_url;
const sourceLabel = fed ? 'the drawing as submitted ↗' : "Simon's original post ↗";

// A fed pelican's card is always addressable: /og/<id>.png serves the one in KV,
// draws it if it is missing, and answers with the zoo's own in the moment before
// either — so there is nothing to look up and no state here to get stale.
//
// An archival card is a committed PNG, made by `npm run og:specimens`, and which
// ones exist is recorded in data/og-cards.json rather than asked of the
// filesystem, since this page is rendered by a server that has no filesystem.
// One that has not been rendered falls back to the zoo's own — a
// wrong-but-present card beats a 404 in every preview that fetches it.
const card = `/og/${s.id}.png`;
const hasCard = fed || ogCards.includes(s.id);

const pageUrl = new URL(`/p/${s.id}`, Astro.site).href;

// A pelican the critic has already been round carries its verdict in its own
// row. That is a different object from the one the button produces: it is the
// same number for every visitor, it is the zoo's, and it is what the badge is
// minted from. Where there is one, show it — asking someone to summon a critic
// who has already reported is theatre.
const assessment = s.assessment || null;
const scored = typeof assessment?.score === 'number';

// Trendshift's shape, which is the shape every directory badge uses: an <img>
// cannot carry a link, so the <a> wrapped round it is the entire point of the
// exercise. No rel="nofollow" — the link back is what the badge is exchanged
// for. The utm_* triple is how GA4 tells which pelican is doing the work.
const badgeSrc = new URL(`/badge/${s.id}.svg`, Astro.site).href;
// The snippet has to be absolute — it is going to be pasted somewhere else —
// but the preview on this page must not be, or every local build and preview
// deploy shows a broken image while pointing at production.
const badgePreview = `/badge/${s.id}.svg`;
const badgeHref = `${pageUrl}?utm_source=badge&utm_medium=badge&utm_campaign=${s.id}`;
// Says what was scored, not just the number. This string is doing two jobs
// besides accessibility: it is what shows when the image does not load, which
// on GitHub is often, and it is the anchor text of the link the badge exists to
// earn — "68/100 at Pelican Zoo" tells a reader and a crawler nothing about
// what this place does.
const badgeAlt = scored
  ? `${s.model} — ${assessment.score}/100 for a pelican riding a bicycle, at Pelican Zoo`
  : '';
// Taken from the endpoint rather than written out again here. The snippet is
// pasted somewhere we will never see, so width and height on the <img> are what
// stops the host page reflowing when the card finally loads — two numbers that
// have to be the card's, not a memory of the card's.
const badgeHtml =
  `<a href="${badgeHref}" target="_blank" rel="noopener">` +
  `<img src="${badgeSrc}" alt="${badgeAlt}" width="${BADGE_W}" height="${BADGE_H}"></a>`;
const badgeMd = `[![${badgeAlt}](${badgeSrc})](${badgeHref})`;

// Hashed from this page's id rather than Math.random: the mix has to differ
// between specimens but stay identical across builds, or every deploy is a
// diff of 104 reshuffled lists with nothing actually changed in them.
function seededRandom(seed) {
  let h = 2166136261;
  for (let i = 0; i < seed.length; i++) {
    h ^= seed.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return () => {
    h ^= h << 13; h ^= h >>> 17; h ^= h << 5;
    return ((h >>> 0) % 1000000) / 1000000;
  };
}

// A page reached from a share is where most people meet this zoo, and until now
// it was a dead end with one bird on it. Six more, picked at random, turn it
// into a door. Only specimens with a standalone image file qualify — a fed
// pelican's drawing lives inside its own page, and inlining six of those would
// cost more than the strip is worth.
const rand = seededRandom(s.id);
const pool = loadZoo()
  .all.filter((x) => x.id !== s.id && (x.svg || x.picture))
  .map((x) => ({
    id: x.id,
    model: x.model,
    thumb: x.svg ? `/live/${x.id}.svg` : x.picture,
    sort: rand(),
  }))
  .sort((a, b) => a.sort - b.sort);
const alsoHere = pool.slice(0, 6);
---

<!doctype html>
<html lang="en">
<head>
<Head
  title={title}
  description={description}
  image={hasCard ? card : '/og.png'}
  imageAlt={`${subject} riding a bicycle, drawn by ${s.model} in ${s.observed}.`}
  imageWidth={hasCard ? 1200 : 2400}
  imageHeight={hasCard ? 630 : 1260}
/>
</head>
<body>

<header class="bar">
  <a class="back" href="/">← every pelican</a>
  <span class="bar-count">
    {fed ? 'fed pen' : 'specimen'}{s.observed ? ` · ${s.observed}` : ''}
  </span>
</header>

<main class="specimen">
  <div class="stage">
    {/* A fed pelican is drawn by a stranger's model and admitted without anyone
        looking at it first, so it goes in an <img> rather than into this
        document. A browser will not run script inside an <img>, will not fetch
        anything it references, and does not care what our regular-expression
        sanitiser missed — animation and scaling still work, and the only thing
        lost is the one thing we were trying to stop. The permanent collection
        is inlined as before: it came from Simon, and it has been on the site
        for a year. */}
    {fed ? (
      <div class="live">
        <img src={`/fed/${s.id}.svg`} alt={`${subject} riding a bicycle, drawn by ${s.model}`} />
      </div>
    ) : s.svg ? (
      <div class="live" set:html={s.svg} />
    ) : (
      <img src={s.picture || s.asset} alt={`${subject} riding a bicycle, drawn by ${s.model}`} />
    )}
    {fed
      ? <span class="badge fed-badge">FED</span>
      : s.svg && <span class="badge live-badge">ALIVE</span>}
    {s.animated && <span class="badge anim-badge">ANIMATED</span>}
    {s.species && s.species !== 'pelican' && <span class="badge odd-badge">{s.species.toUpperCase()}</span>}
  </div>

  <div class="plaque">
    <h1>{s.model}</h1>
    <p class="latin">
      <em>Pelecanus velocipedus</em>
      {fed && <span> · self-reported</span>}
      {s.effort && <span class="effort"> · effort: {s.effort}</span>}
    </p>

    <dl>
      <div><dt>Genus</dt><dd>{s.vendor}</dd></div>
      {fed ? (
        <>
          {s.observed && <div><dt>Fed</dt><dd>{s.observed}</dd></div>}
          {s.by && <div><dt>By</dt><dd>{s.by}</dd></div>}
        </>
      ) : (
        <>
          <div><dt>First observed</dt><dd>{s.observed}</dd></div>
          <div><dt>Preservation</dt><dd>{s.svg ? 'live vector' : `${s.format} print`}</dd></div>
        </>
      )}
    </dl>

    {fed && (
      <p class="caveat">
        Sent in by a visitor. Nobody can check who drew a pelican, so the model
        above is whatever the person who sent it typed — which is also why fed
        pelicans stay out of the guessing game.
      </p>
    )}

    {s.verdict && (
      <blockquote class="note">
        {s.verdict}
        <cite>— {fed ? `fed by ${s.by || 'a visitor'}` : "keeper's log"}</cite>
      </blockquote>
    )}

    <div class="critic">
      {scored ? (
        // Rendered at build time from the file, not fetched: no click, no call
        // to the worker, no rate limit, and every visitor reads the same
        // sentence about the same number.
        <>
          <div class="score" data-band={bandOf(assessment.score)}>
            <b>{assessment.score}</b><span>/100</span>
          </div>
          <blockquote class="roast-out">
            {assessment.review}
            <cite>— the zoo's critic, {assessment.critic}</cite>
          </blockquote>
        </>
      ) : s.svg ? (
        <>
          {/* The id is enough for both kinds now: the server reads a specimen
              out of its own bundle and a fed pelican out of the database. */}
          <button class="roast" data-id={s.id} data-model={s.model}>
            summon the critic ↯
          </button>
          <blockquote class="roast-out" hidden></blockquote>
        </>
      ) : (
        // The critic reads source, and there is none: this one survives only as
        // a picture. Saying so is better than a button that cannot work.
        <p class="no-critic">
          The critic reads the drawing's source, and this specimen has none —
          only a photograph of it survives.
        </p>
      )}
    </div>

    <div class="actions">
      <a class="source" href={sourceUrl} rel="noopener">{sourceLabel}</a>
      <a
        class="share"
        href="#"
        rel="noopener"
        data-url={pageUrl}
        data-model={s.model}
        data-score={scored ? String(assessment.score) : undefined}
      >share on X</a>
    </div>

    {/* The share asks people to feed the zoo one of their own, and this is the
        door that ask points at. Without it the invitation lands on a page with
        no way to accept it. */}
    <a class="feed-cta" href="/#feed">
      <b>feed the zoo yours ↑</b>
      <span>got a pelican out of a model? send it in</span>
    </a>
  </div>

  {/* Its own band across both columns rather than a block inside the plaque.
      The plaque is a narrow caption beside a picture; an embed snippet is a
      hundred-odd characters of URL, and folding that into a third of the page
      both wrapped it into an unreadable stack and left the picture's column
      empty for the length of it. */}
  {scored && (
    <section class="papers">
      <h2>papers</h2>
      <p class="lede">
        The zoo has examined this pelican and is prepared to say so in public.
        The critic does not grade on a curve and does not revise upward out of
        politeness — the badge says what it says. Hang it on your own wall.
      </p>
      <p class="badge-preview"><img src={badgePreview} alt={badgeAlt} width={BADGE_W} height={BADGE_H} /></p>
      <div class="snippets">
        {/* One line each, not a block of wrapped markup. Nobody reads an embed
            snippet; they copy it. Not a <label> either — it would wrap the copy
            button too, and pressing the button would also be a press on the
            field beside it. */}
        <div class="field">
          <span id={`${s.id}-html`}>HTML</span>
          <input readonly value={badgeHtml} data-copy aria-labelledby={`${s.id}-html`} />
          <button class="copy" type="button">copy</button>
        </div>
        <div class="field">
          <span id={`${s.id}-md`}>MD</span>
          <input readonly value={badgeMd} data-copy aria-labelledby={`${s.id}-md`} />
          <button class="copy" type="button">copy</button>
        </div>
      </div>
      <p class="fineprint">
        Drawn fresh on every build, so it follows the record rather than freezing
        a good day. The critic is rewritten now and then, and every pelican is
        assessed again when it is — a 68 is not a life sentence in either
        direction.
      </p>
    </section>
  )}
</main>

{alsoHere.length > 0 && (
  <section class="also">
    <h2>also in the zoo</h2>
    <ul>
      {alsoHere.map((o) => (
        <li>
          <a href={`/p/${o.id}`}>
            <span class="thumb"><img src={o.thumb} alt="" loading="lazy" /></span>
            <span class="who">{o.model}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="all-link" href="/">every pelican →</a>
  </section>
)}

<footer>
  <p>
    {fed ? (
      <>
        Sent in through the feed pen and merged by hand. The benchmark is
        <a href="https://simonwillison.net/tags/pelican-riding-a-bicycle/" rel="noopener"> Simon Willison's</a>.
      </>
    ) : (
      <>
        The image and the keeper's note are
        <a href="https://simonwillison.net/tags/pelican-riding-a-bicycle/" rel="noopener"> Simon Willison's</a>,
        linked to source. We built the enclosure.
      </>
    )} — <a href="/">pelicanzoo.ai</a>
  </p>
</footer>

<script is:inline>
  const share = document.querySelector('.share');
  const btn = document.querySelector('.roast');
  const out = document.querySelector('.roast-out');

  // A share is not a scoreboard post, it is a recruitment post: what drew this,
  // how badly it went, and an invitation to send one in. The zoo only grows by
  // people feeding it, so the ask is the half that has to survive being read in
  // a timeline. Rebuilt rather than templated, so the score can slot in later
  // without the two versions of the sentence drifting apart.
  function shareHref(score) {
    const model = share.dataset.model;
    const verdict = score === null
      ? `${model} drew this pelican riding a bicycle.`
      : `${model} scored ${score}/100 for "a pelican riding a bicycle".`;
    const text = `${verdict} Feed the zoo yours:`;
    return 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(text) +
      '&url=' + encodeURIComponent(share.dataset.url);
  }
  // Already on file for an assessed pelican, so the number is in the tweet from
  // the first paint instead of waiting for a click that will never come.
  share.href = shareHref(share.dataset.score ? Number(share.dataset.score) : null);
  share.addEventListener('click', () => window.zooTrack('share', { model: share.dataset.model }));

  // The badge is only worth minting if it ends up somewhere, and it only ends up
  // somewhere if the snippet is one button away from the clipboard.
  for (const copy of document.querySelectorAll('.copy')) {
    copy.addEventListener('click', async () => {
      const field = copy.parentElement.querySelector('[data-copy]');
      try {
        await navigator.clipboard.writeText(field.value);
      } catch {
        // No clipboard permission, or an insecure origin. Selecting it still
        // leaves the reader one keystroke away rather than stranded.
        field.select();
      }
      copy.textContent = 'copied';
      setTimeout(() => (copy.textContent = 'copy'), 1400);
      window.zooTrack('badge_copy', { model: share.dataset.model });
    });
  }

  if (btn) btn.addEventListener('click', async () => {
    btn.disabled = true;
    btn.textContent = 'the critic is looking…';

    // Every pelican on this site is now something the server can look up for
    // itself — the collection out of its own bundle, the feed pen out of the
    // database — so nothing needs to travel with the request. A drawing sent
    // from a browser would also be a drawing a browser could edit first.
    const payload = { id: btn.dataset.id };

    let data;
    try {
      const r = await fetch('/api/roast', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      data = await r.json();
    } catch {
      data = { error: 'could not reach the critic.' };
    }

    out.hidden = false;
    out.textContent = '';
    // textContent, never innerHTML: this string came out of a language model.
    out.appendChild(document.createTextNode(data.roast || data.error || 'the critic is unavailable.'));

    if (data.roast) {
      const cite = document.createElement('cite');
      cite.textContent = `— the zoo's critic, ${data.critic}`;
      out.appendChild(cite);
      if (typeof data.score === 'number') {
        const box = document.createElement('div');
        box.className = 'score';
        box.dataset.band = data.score >= 60 ? 'high' : data.score >= 30 ? 'mid' : 'low';
        const n = document.createElement('b');
        n.textContent = data.score;
        const o = document.createElement('span');
        o.textContent = '/100';
        box.append(n, o);
        out.before(box);
        // A number is what makes the share worth clicking, so it goes into the
        // text the moment there is one.
        share.href = shareHref(data.score);
      }
      btn.remove();
    } else {
      btn.disabled = false;
      btn.textContent = 'summon the critic ↯';
    }

    window.zooTrack('roast', {
      model: btn.dataset.model,
      ok: data.roast ? 'yes' : 'no',
      score: data.score ?? -1,
    });
  });
</script>

<style is:global>
  .bar {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: .9rem 1.25rem; background: var(--plaque); color: #f6f2e6;
    border-bottom: 4px solid var(--brass);
  }
  .back { color: var(--brass); text-decoration: none; font: 600 .85rem/1 inherit; }
  .back:hover { text-decoration: underline; }
  .bar-count { font: 500 .72rem/1 ui-monospace, monospace; opacity: .6; letter-spacing: .08em; }

  .specimen {
    max-width: 68rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem;
    display: grid; gap: 2rem; align-items: start;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  }
  @media (max-width: 52rem) { .specimen { grid-template-columns: 1fr; } }

  /* Deliberately taller than the grid's 4:3 pens: this is the page you land on
     from a link, and the bird is the reason you came. */
  .stage {
    position: relative; aspect-ratio: 1 / 1; background: #fff;
    border: 1px solid var(--rule); border-radius: 4px; overflow: hidden;
    box-shadow: 0 1px 2px rgba(0,0,0,.04);
  }
  /* Percentage heights stay indefinite under aspect-ratio, so both children get
     pinned to the box instead — same trap the grid hit. */
  .stage > img, .stage > .live { position: absolute; inset: 0; }
  .stage > img { margin: auto; width: auto; height: auto; max-width: 100%; max-height: 100%; display: block; }
  .stage > .live { display: grid; place-items: center; padding: 1.5rem; }
  .stage > .live svg,
  .stage > .live img { max-width: 100%; max-height: 100%; display: block; }

  .badge {
    position: absolute; top: .7rem; font: 700 .62rem/1 ui-monospace, monospace;
    letter-spacing: .1em; padding: .32rem .48rem; border-radius: 2px;
  }
  .live-badge { left: .7rem; background: var(--plaque); color: var(--brass); }
  /* Left, where ALIVE sits on a specimen — a fed pelican never has both. */
  .fed-badge { left: .7rem; background: #8a6a12; color: #fff; }
  .anim-badge { right: .7rem; background: var(--brass); color: #1e1a10; }
  .odd-badge { bottom: .7rem; top: auto; left: .7rem; background: #8a3b2a; color: #fff; }

  /* Stated plainly rather than in a footnote: an unverifiable model name is
     the one thing a visitor could otherwise take this page to be asserting. */
  .caveat {
    margin: .7rem 0 0; padding: .65rem .8rem; background: #f7f3e6;
    border-left: 3px solid #8a6a12;
    font-size: .78rem; line-height: 1.5; color: #5d5647;
  }

  .plaque {
    background: var(--card); border: 1px solid var(--rule); border-radius: 4px;
    padding: 1.5rem 1.4rem; display: flex; flex-direction: column; gap: .6rem;
  }
  .plaque h1 {
    margin: 0; font: 600 1.4rem/1.25 ui-monospace, "SF Mono", monospace;
    word-break: break-word;
  }
  .latin { margin: 0; font-size: .82rem; color: var(--muted); }
  .effort { color: #9a7b24; }
  .plaque dl { margin: .5rem 0 0; display: grid; gap: .32rem; font-size: .8rem; }
  .plaque dl div { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px dotted var(--rule); padding-bottom: .32rem; }
  .plaque dt { color: var(--muted); }
  .plaque dd { margin: 0; text-align: right; }

  .note {
    margin: .6rem 0 0; padding: .8rem .9rem; background: #f7f3e6;
    border-left: 3px solid var(--brass); font-size: .87rem; line-height: 1.5;
  }
  .note cite { display: block; margin-top: .45rem; font-size: .72rem; color: var(--muted); font-style: normal; }

  .critic { margin-top: .8rem; }
  .roast {
    font: 600 .78rem/1 ui-monospace, "SF Mono", monospace; letter-spacing: .04em;
    padding: .6rem .85rem; cursor: pointer; background: none; color: var(--plaque);
    border: 1px dashed var(--rule); border-radius: 3px; transition: .12s;
  }
  .roast:hover:not(:disabled) { border-style: solid; border-color: var(--plaque); background: #f7f5ee; }
  .roast:disabled { cursor: wait; opacity: .5; }
  .no-critic { margin: 0; font-size: .8rem; color: var(--muted); line-height: 1.5; }
  .roast-out {
    margin: 0; padding: .8rem .9rem; background: #fbf7ea;
    border-left: 3px solid var(--plaque); font-size: .88rem; line-height: 1.55; font-style: italic;
  }
  .roast-out cite {
    display: block; margin-top: .5rem;
    font: 500 .72rem/1 ui-monospace, monospace; color: var(--muted); font-style: normal;
  }
  /* The number is the payload. Everything else on this page is context for it,
     so it is sized like a headline rather than like a stat in a table — and it
     is the thing someone screenshots, which only works if it survives being
     shrunk into a timeline. */
  .score {
    display: flex; align-items: baseline; justify-content: center; gap: .45rem;
    margin: 0 0 .7rem; padding: .9rem .8rem .7rem;
    background: #fbf7ea; border: 1px solid var(--rule); border-radius: 4px;
    font: 700 5.2rem/.85 Georgia, "Iowan Old Style", serif;
    letter-spacing: -.02em;
    /* Georgia defaults to old-style figures, so a 7 drops below the baseline and
       runs under the /100 beside it. A score should read as a number, not as a
       flourish. */
    font-variant-numeric: lining-nums;
  }
  .score span { font: 500 1rem/1 ui-monospace, monospace; color: var(--muted); }
  .score[data-band='low'] b { color: #8a3b2a; }
  .score[data-band='mid'] b { color: #9a7b24; }
  .score[data-band='high'] b { color: var(--plaque); }

  /* The certificate. It comes after the plaque on purpose: someone who has just
     read a number is the one person who wants a badge of it, and someone who
     wants a badge of it needs a pelican first.

     Laid out as a document rather than as a documentation block — ruled twice
     round, centred, the badge hung in the middle of it. A stack of left-aligned
     code boxes reads like a README, and the thing being handed over is an
     award. It spans both columns but is narrower than either pair of them: a
     certificate is a sheet of paper, and stretched to the full 68rem it was a
     thin line of text with a quarter of the band empty on each side.

     52rem is the card plus its padding. The preview is the actual file at its
     actual size, because the one question anybody has about an embed is how
     big the thing is going to be on their page, and a preview scaled down to
     fit answers it wrongly. */
  .papers {
    grid-column: 1 / -1; position: relative;
    max-width: 52rem; margin: 0 auto; width: 100%;
    padding: 2.2rem 2rem 1.7rem; text-align: center;
    background: var(--card); border: 1px solid var(--rule); border-radius: 4px;
  }
  .papers::before {
    content: ''; position: absolute; inset: 6px; pointer-events: none;
    border: 1px solid var(--rule); border-radius: 2px; opacity: .6;
  }
  /* Brass rules either side, the way the plaques in here are set. */
  .papers h2 {
    display: flex; align-items: center; justify-content: center; gap: .75rem;
    margin: 0 0 .8rem;
    font: 700 .72rem/1 ui-monospace, monospace; letter-spacing: .3em;
    text-transform: uppercase; color: #9a7b24; text-indent: .3em;
  }
  .papers h2::before, .papers h2::after {
    content: ''; width: 2.2rem; height: 1px; background: var(--brass); opacity: .7;
  }
  /* The prose, the snippets and the small print all sit on one 34rem measure, so
     the block has a single invisible edge down either side instead of three. */
  .papers .lede {
    max-width: 34rem; margin: 0 auto 1.6rem;
    font-size: .88rem; line-height: 1.6; color: #4a4437;
  }
  /* Off the page a little, like something hung on a wall rather than printed
     into it — it is the one object here that is meant to leave. */
  .badge-preview { margin: 0 0 1.6rem; }
  /* No radius: the card draws its own border, and rounding the element clips
     the corners off it. */
  .badge-preview img {
    display: inline-block; max-width: 100%; height: auto;
    box-shadow: 0 2px 7px rgba(34, 32, 27, .13);
  }

  /* One row per format: caption, the snippet on a single scrolling line, and the
     button that is the only thing anybody actually does with either. */
  .snippets { max-width: 34rem; margin: 0 auto; display: grid; gap: .45rem; text-align: left; }
  .field {
    display: flex; align-items: stretch; overflow: hidden;
    border: 1px solid var(--rule); border-radius: 3px; background: var(--paper);
  }
  .field:focus-within { border-color: var(--brass); }
  /* Fixed width, not shrink-to-fit: HTML is twice the word MD, and left to
     themselves the two captions push their snippets to two different left
     edges. Three ragged columns in a block four lines tall. */
  .field span {
    flex: none; width: 3.4rem; display: flex; align-items: center; justify-content: center;
    background: #f1ecdd; border-right: 1px solid var(--rule);
    font: 700 .62rem/1 ui-monospace, monospace; letter-spacing: .12em; color: var(--muted);
  }
  .field input {
    flex: 1; min-width: 0; padding: .55rem .6rem;
    border: 0; background: none; outline: none; text-overflow: ellipsis;
    color: var(--muted); font: .72rem/1 ui-monospace, monospace;
  }
  /* Wide enough for "copied" as well as "copy", so pressing it does not shove
     the snippet sideways while it says so. */
  .copy {
    flex: none; width: 4.4rem; cursor: pointer;
    border: 0; border-left: 1px solid var(--rule);
    background: #f1ecdd; color: var(--muted); transition: .12s;
    font: 700 .64rem/1 ui-monospace, monospace; letter-spacing: .08em;
  }
  .copy:hover { background: var(--plaque); color: var(--brass); }
  /* Ruled off the offer above it: everything before this line is the award,
     everything after is the terms it comes with. */
  .fineprint {
    max-width: 34rem; margin: 1.5rem auto 0; padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    font-size: .74rem; line-height: 1.55; color: var(--muted);
  }

  .feed-cta {
    margin-top: .9rem; padding: .85rem .95rem; display: block;
    background: var(--plaque); color: #f6f2e6; border-radius: 4px;
    text-decoration: none; transition: .12s;
  }
  .feed-cta b { display: block; font: 600 .84rem/1.3 ui-monospace, "SF Mono", monospace; color: var(--brass); }
  .feed-cta span { display: block; margin-top: .2rem; font-size: .76rem; opacity: .75; }
  .feed-cta:hover { filter: brightness(1.18); }

  .also { max-width: 68rem; margin: 0 auto; padding: 0 1.25rem 3rem; }
  .also h2 {
    margin: 0 0 .9rem; padding-top: 1.6rem; border-top: 1px solid var(--rule);
    font: 600 .8rem/1 ui-monospace, monospace; letter-spacing: .1em;
    text-transform: uppercase; color: var(--muted);
  }
  .also ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 1rem; grid-template-columns: repeat(6, 1fr); }
  @media (max-width: 52rem) { .also ul { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 30rem) { .also ul { grid-template-columns: repeat(2, 1fr); } }
  .also a { text-decoration: none; color: inherit; display: block; }
  .thumb {
    display: block; aspect-ratio: 4 / 3; background: #fff;
    border: 1px solid var(--rule); border-radius: 3px; overflow: hidden;
  }
  .thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .who {
    display: block; margin-top: .4rem; font: 500 .7rem/1.35 ui-monospace, monospace;
    color: var(--muted); overflow-wrap: anywhere;
  }
  .also a:hover .thumb { border-color: var(--plaque); }
  .also a:hover .who { color: var(--plaque); }
  .all-link { display: inline-block; margin-top: 1.1rem; font-size: .8rem; color: var(--muted); }

  .actions {
    margin-top: 1rem; padding-top: .9rem; border-top: 1px solid var(--rule);
    display: flex; flex-wrap: wrap; gap: 1.1rem; font-size: .8rem;
  }
  .actions a { color: var(--muted); text-decoration: none; }
  .actions a:hover { color: var(--plaque); text-decoration: underline; }
  .share { font-weight: 600; color: var(--plaque) !important; }

  footer { padding: 2rem 1.5rem 3.5rem; text-align: center; color: var(--muted); font-size: .8rem; border-top: 1px solid var(--rule); }
  footer a { color: var(--muted); }
</style>
</body>
</html>
