---
// Client payload: keep it small — images load from their own URLs, not inlined.
const { rounds } = Astro.props;
---
<section class="game" id="game">
  <div class="game-head">
    <h2>Who drew this one?</h2>
    <p>Same prompt, {rounds.models} different models. Can you tell them apart?</p>
  </div>

  <div class="board">
    <div class="stage">
      <img id="g-img" alt="" hidden />
      <div id="g-live" class="g-live" hidden></div>
      <span id="g-year" class="g-year"></span>
    </div>

    <div class="play">
      <div id="g-options" class="options"></div>

      <div id="g-result" class="result" hidden>
        <p class="verdict"><strong id="g-verdict"></strong> <span id="g-answer"></span></p>
        <blockquote id="g-note" class="g-note"></blockquote>
        <a id="g-src" class="g-src" rel="noopener" target="_blank"></a>
        <button id="g-next" class="next">Next pelican →</button>
      </div>

      <div class="score">
        <span id="g-score">0 / 0</span>
        <button id="g-reset" class="reset" hidden>Start over</button>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="g-data" set:html={JSON.stringify(rounds.items)}></script>

<script is:inline>
(() => {
  const DATA = JSON.parse(document.getElementById('g-data').textContent);
  const el = (id) => document.getElementById(id);
  const img = el('g-img'), liveBox = el('g-live'), optsBox = el('g-options');
  let right = 0, total = 0, cur = null, answered = false;

  const pick = (arr, n) => {
    const c = [...arr];
    for (let i = c.length - 1; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; [c[i], c[j]] = [c[j], c[i]]; }
    return c.slice(0, n);
  };

  async function round() {
    answered = false;
    cur = DATA[(Math.random() * DATA.length) | 0];

    // Show the pelican. Live vectors get inlined so they animate.
    if (cur.svg) {
      img.hidden = true; liveBox.hidden = false;
      liveBox.innerHTML = '<span class="loading">loading…</span>';
      try {
        const r = await fetch(cur.svg);
        liveBox.innerHTML = await r.text();
      } catch { liveBox.innerHTML = ''; img.hidden = false; img.src = cur.src; liveBox.hidden = true; }
    } else {
      liveBox.hidden = true; liveBox.innerHTML = '';
      img.hidden = false; img.src = cur.src;
      img.alt = 'A pelican riding a bicycle, drawn by a language model';
    }
    el('g-year').textContent = cur.year;

    // Decoys come from other vendors where possible. Three Gemini variants next
    // to each other is unguessable, which reads as unfair rather than hard.
    const others = DATA.filter((d) => d.model !== cur.model);
    const byVendor = new Map();
    for (const d of pick(others, others.length)) {
      if (d.vendor === cur.vendor) continue;
      if (!byVendor.has(d.vendor)) byVendor.set(d.vendor, d.model);
    }
    let wrong = pick([...byVendor.values()], 3);
    if (wrong.length < 3) {
      const extra = [...new Set(others.map((d) => d.model))].filter((m) => !wrong.includes(m));
      wrong = [...wrong, ...pick(extra, 3 - wrong.length)];
    }
    const choices = pick([cur.model, ...wrong], 4);

    optsBox.innerHTML = '';
    for (const m of choices) {
      const b = document.createElement('button');
      b.className = 'opt'; b.textContent = m; b.dataset.model = m;
      b.addEventListener('click', () => answer(b, m));
      optsBox.appendChild(b);
    }
    el('g-result').hidden = true;
  }

  function answer(btn, model) {
    if (answered) return;
    answered = true;
    total++;
    const ok = model === cur.model;
    if (ok) right++;

    [...optsBox.children].forEach((b) => {
      b.disabled = true;
      if (b.dataset.model === cur.model) b.classList.add('correct');
      else if (b === btn) b.classList.add('wrong');
    });

    el('g-verdict').textContent = ok ? 'Correct.' : 'Nope —';
    el('g-verdict').className = ok ? 'ok' : 'no';
    el('g-answer').textContent = ok ? `It was ${cur.model}.` : `that was ${cur.model}.`;
    const note = el('g-note');
    note.hidden = !cur.note;
    if (cur.note) note.innerHTML = `${cur.note}<cite>— Simon Willison, on this pelican</cite>`;
    const src = el('g-src');
    src.href = cur.url; src.textContent = cur.title;
    el('g-result').hidden = false;
    el('g-score').textContent = `${right} / ${total}`;
    el('g-reset').hidden = total < 3;
  }

  el('g-next').addEventListener('click', round);
  el('g-reset').addEventListener('click', () => { right = total = 0; el('g-score').textContent = '0 / 0'; el('g-reset').hidden = true; round(); });
  round();
})();
</script>

<style is:global>
  [hidden] { display: none !important; }
  .game { max-width: 74rem; margin: 0 auto; padding: 3rem 1.25rem 1rem; }
  .game-head { text-align: center; margin-bottom: 1.6rem; }
  .game-head h2 { margin: 0; font: 700 clamp(1.5rem,4vw,2.2rem)/1.1 Georgia, serif; }
  .game-head p { margin: .5rem 0 0; color: var(--muted); }

  .board {
    display: grid; gap: 1.5rem; align-items: start;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    background: var(--card); border: 1px solid var(--rule); border-radius: 6px;
    padding: 1.25rem; box-shadow: 0 6px 24px rgba(0,0,0,.06);
  }
  @media (max-width: 760px) { .board { grid-template-columns: 1fr; } }

  .stage {
    position: relative; aspect-ratio: 4/3; background: #fff;
    border: 1px solid var(--rule); border-radius: 4px; overflow: hidden;
    display: grid; place-items: center;
  }
  /* The stage gets its height from aspect-ratio, which leaves percentage heights
     on the children indefinite — a square pelican came out 550px tall in a 414px
     box and got its bicycle cropped. Absolute inset:0 gives a definite box. */
  .stage > img, .stage > .g-live { position: absolute; inset: 0; }
  .stage > img { margin: auto; width: auto; height: auto; max-width: 100%; max-height: 100%; display: block; }
  .g-live { display: grid; place-items: center; }
  .g-live svg { max-width: 100%; max-height: 100%; display: block; }
  .loading { color: var(--muted); font-size: .8rem; }
  .g-year {
    position: absolute; bottom: .5rem; right: .6rem; font: 700 .65rem/1 ui-monospace, monospace;
    letter-spacing: .1em; color: var(--muted); background: rgba(255,255,255,.85); padding: .25rem .4rem; border-radius: 2px;
  }

  .play { display: flex; flex-direction: column; gap: 1rem; min-height: 100%; }
  .options { display: grid; gap: .55rem; }
  .opt {
    font: 500 .88rem/1.3 ui-monospace, "SF Mono", monospace; text-align: left;
    padding: .8rem .9rem; cursor: pointer; word-break: break-word;
    background: #fff; color: var(--ink);
    border: 1px solid var(--rule); border-radius: 4px; transition: .12s;
  }
  .opt:hover:not(:disabled) { border-color: var(--plaque); background: #f7f5ee; }
  .opt:disabled { cursor: default; opacity: .55; }
  .opt.correct { background: #1e3a2b; color: #fff; border-color: #1e3a2b; opacity: 1; }
  .opt.wrong { background: #8a3b2a; color: #fff; border-color: #8a3b2a; opacity: 1; }

  .result { display: flex; flex-direction: column; gap: .7rem; }
  .verdict { margin: 0; font-size: .95rem; }
  .verdict .ok { color: #1e3a2b; } .verdict .no { color: #8a3b2a; }
  .g-note {
    margin: 0; padding: .75rem .85rem; background: #f7f3e6;
    border-left: 3px solid var(--brass); font-size: .85rem; line-height: 1.5;
  }
  .g-note cite { display: block; margin-top: .45rem; font-size: .72rem; color: var(--muted); font-style: normal; }
  .g-src { font-size: .78rem; color: var(--muted); }
  .g-src:hover { color: var(--plaque); }
  .next {
    align-self: flex-start; font: 600 .85rem/1 inherit; padding: .7rem 1.1rem; cursor: pointer;
    background: var(--plaque); color: #fff; border: 0; border-radius: 4px;
  }
  .score {
    margin-top: auto; padding-top: .8rem; border-top: 1px solid var(--rule);
    display: flex; justify-content: space-between; align-items: center;
    font: 700 1.05rem/1 ui-monospace, monospace;
  }
  .reset { font: 500 .75rem/1 inherit; background: none; border: 0; color: var(--muted); cursor: pointer; text-decoration: underline; }
</style>
</section>
