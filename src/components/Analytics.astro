---
import { GA4_ID } from '../lib/config.js';
---

<script is:inline define:vars={{ GA4_ID }}>
  // Always defined, so call sites never have to know whether analytics loaded.
  window.zooTrack = (name, params) => {
    if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
  };

  // A measurement ID is public — it ships in the HTML either way — so it lives
  // in the source rather than a build variable, and the gate is at runtime.
  // Skipping by hostname instead of allow-listing one: a preview deployment
  // sending a little noise beats production silently reporting nothing because
  // its domain was not on a list.
  const local = ['localhost', '127.0.0.1', '::1', ''].includes(location.hostname)
    || location.hostname.endsWith('.local')
    || location.protocol === 'file:';

  if (!local) {
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    gtag('js', new Date());
    gtag('config', GA4_ID);
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
    document.head.appendChild(s);
  }
</script>
